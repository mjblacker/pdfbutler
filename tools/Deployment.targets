<Project>
  <!-- Shared by the folder profiles, including direct dotnet publish / IDE publishing. -->
  <Target Name="ValidateDeploymentDestination" BeforeTargets="PrepareForPublish" Condition="'$(PdfButlerDeployment)' == 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'linux-x64'"
           Text="Deployment supports only win-x64 and linux-x64." />
    <Error Condition="'$(PublishTrimmed)' == 'true'"
           Text="Deployment must be untrimmed; trimming has not been validated." />
    <Error Condition="'$(IncludeNativeLibrariesForSelfExtract)' == 'true' or '$(IncludeAllContentForSelfExtract)' == 'true'"
           Text="Native libraries must remain beside the executable; self-extraction is not supported." />
    <Error Condition="'$(PublishDir)' == ''" Text="A deployment output directory is required." />
  </Target>

  <Target Name="CleanDeploymentDirectory" BeforeTargets="PrepareForPublish"
          DependsOnTargets="ValidateDeploymentDestination" Condition="'$(PdfButlerDeployment)' == 'true'">
    <PropertyGroup>
      <_DeploymentRepository>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</_DeploymentRepository>
      <_DeploymentDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_DeploymentDirectory>
      <_CleanPublishMode>auto</_CleanPublishMode>
      <_CleanPublishMode Condition="'$(CleanPublishDirectory)' != ''">$(CleanPublishDirectory)</_CleanPublishMode>
    </PropertyGroup>
    <!-- The final dot avoids a quoted trailing backslash in Windows process arguments. -->
    <Exec Command="dotnet fsi --exec &quot;$(MSBuildThisFileDirectory)Clean-Publish.fsx&quot; &quot;$(_DeploymentRepository).&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_DeploymentDirectory).&quot; &quot;$(_CleanPublishMode)&quot;" />
  </Target>

  <Target Name="PrepareDeploymentFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- Native packages ship ~100 MiB of PDBs; none are needed to run the reader. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
      <_RuntimeNoticePack Include="@(ResolvedRuntimePack)" Condition="'$(SelfContained)' == 'true' and '%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <ResolvedFileToPublish Include="@(_RuntimeNoticePack->'%(PackageDirectory)/LICENSE.TXT')" RelativePath="licenses/dotnet/LICENSE.TXT" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_RuntimeNoticePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" RelativePath="licenses/dotnet/THIRD-PARTY-NOTICES.TXT" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="VerifyDeploymentFiles" AfterTargets="Publish" Condition="'$(PdfButlerDeployment)' == 'true'">
    <PropertyGroup>
      <_DeploymentNativeLibrary Condition="'$(RuntimeIdentifier)' == 'win-x64'">pdfium.dll</_DeploymentNativeLibrary>
      <_DeploymentNativeLibrary Condition="'$(RuntimeIdentifier)' == 'linux-x64'">libpdfium.so</_DeploymentNativeLibrary>
    </PropertyGroup>
    <Error Condition="!Exists('$(PublishDir)$(_DeploymentNativeLibrary)')"
           Text="Missing $(_DeploymentNativeLibrary) beside the application; do not deploy this folder." />
    <Message Importance="high" Text="Ready: $(PublishDir)" />
  </Target>

  <Target Name="ArchiveDeployment" AfterTargets="Publish" DependsOnTargets="VerifyDeploymentFiles"
          Condition="'$(PdfButlerDeployment)' == 'true' and '$(CreatePublishArchive)' == 'true'">
    <PropertyGroup>
      <_ArchiveSource>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_ArchiveSource>
      <!-- A sibling, never inside the folder being zipped (including for custom -o). -->
      <_DeploymentArchive>$([System.IO.Path]::TrimEndingDirectorySeparator('$(_ArchiveSource)')).zip</_DeploymentArchive>
    </PropertyGroup>
    <ZipDirectory SourceDirectory="$(_ArchiveSource)" DestinationFile="$(_DeploymentArchive).tmp" Overwrite="true" />
    <Move SourceFiles="$(_DeploymentArchive).tmp" DestinationFiles="$(_DeploymentArchive)" />
    <Message Importance="high" Text="Beta archive: $(_DeploymentArchive)" />
  </Target>
</Project>
