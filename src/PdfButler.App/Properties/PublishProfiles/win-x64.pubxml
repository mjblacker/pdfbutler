<Project>
  <PropertyGroup>
    <PdfButlerDeployment>true</PdfButlerDeployment>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Native AOT: one native executable, no .NET runtime to install. Building needs the MSVC
         linker (Visual Studio "Desktop development with C++"). -p:PublishAot=false gives a
         self-contained JIT folder for comparison or diagnostics. -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <!-- Reflection-based JSON and dynamic interop fail at runtime under AOT: keep them build errors. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
    <CreatePublishArchive Condition="'$(CreatePublishArchive)' == ''">true</CreatePublishArchive>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- The AOT targets otherwise copy any native PdfButler.pdb left in obj/ (85 MB). -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../artifacts/publish/win-x64/</PublishDir>
  </PropertyGroup>
</Project>
