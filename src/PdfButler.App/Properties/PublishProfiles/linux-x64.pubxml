<Project>
  <PropertyGroup>
    <PdfButlerDeployment>true</PdfButlerDeployment>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <!-- Native AOT: publish on Linux (no cross-OS AOT) with clang and zlib1g-dev installed.
         The executable needs the build machine's glibc version or newer. -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
    <StripSymbols>true</StripSymbols>
    <CreatePublishArchive Condition="'$(CreatePublishArchive)' == ''">true</CreatePublishArchive>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Never copy a native PdfButler.dbg into the deployment folder. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../artifacts/publish/linux-x64/</PublishDir>
  </PropertyGroup>
</Project>
